<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exo-Defense | Orbital TD</title>
    <style>
        :root { --neon: #0ff; --danger: #f44; --accent: #f0f; }
        body { margin: 0; background: #020205; color: var(--neon); font-family: 'Segoe UI', Tahoma, sans-serif; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
        canvas { background: #000; border: 1px solid #1a3a5a; cursor: crosshair; max-width: 95vw; max-height: 80vh; border-radius: 4px; box-shadow: 0 0 40px rgba(0,0,0,0.5); }
        #ui { position: absolute; top: 20px; left: 20px; pointer-events: none; }
        .stat { margin-bottom: 5px; text-transform: uppercase; letter-spacing: 2px; font-weight: bold; text-shadow: 0 0 10px var(--neon); }
        #shop, #upgrade-menu { position: absolute; bottom: 30px; display: flex; gap: 10px; padding: 10px; background: rgba(5, 5, 20, 0.8); border-radius: 8px; border: 1px solid #333; pointer-events: auto; }
        #upgrade-menu { display: none; border-color: var(--neon); flex-direction: column; bottom: 100px; }
        .btn { background: rgba(0, 255, 255, 0.05); border: 1px solid var(--neon); color: var(--neon); padding: 12px; cursor: pointer; transition: 0.2s; min-width: 110px; text-align: center; border-radius: 4px; }
        .btn:hover { background: rgba(0, 255, 255, 0.2); box-shadow: 0 0 15px var(--neon); }
        .btn.active { background: var(--neon); color: #000; }
        .btn span { display: block; font-size: 0.7em; opacity: 0.7; margin-top: 4px; }
        .repair { border-color: #0f0; color: #0f0; }
        .close { border-color: var(--danger); color: var(--danger); margin-top: 10px; }
    </style>
</head>
<body>
    <div id="ui">
        <div class="stat">Integrity: <span id="health">100</span>%</div>
        <div class="stat">Scrap: <span id="money">100</span></div>
        <div class="stat">Wave: <span id="wave">0</span></div>
    </div>

    <canvas id="gameCanvas"></canvas>

    <div id="shop">
        <button class="btn repair" onclick="repairPlanet()">REPAIR<span>50 SCRAP</span></button>
        <button class="btn" id="btn-BEAM" onclick="setTurret('BEAM')">LASER<span>25</span></button>
        <button class="btn" id="btn-PULSE" onclick="setTurret('PULSE')">PULSE<span>60</span></button>
        <button class="btn" id="btn-MINER" onclick="setTurret('MINER')">MINER<span>40</span></button>
        <button class="btn" id="btn-GRAVITY" onclick="setTurret('GRAVITY')">SLOW<span>75</span></button>
        <button class="btn" id="btn-RAILGUN" onclick="setTurret('RAILGUN')">RAILGUN<span>120</span></button>
    </div>

    <div id="upgrade-menu">
        <div id="upgrade-title" style="text-align:center; font-weight:bold">TURRET</div>
        <div style="display:flex; gap:10px;">
            <button class="btn" onclick="upgradeStat('damage')">DAMAGE <span id="u-dmg">30</span></button>
            <button class="btn" onclick="upgradeStat('range')">RANGE <span id="u-rng">30</span></button>
            <button class="btn" onclick="upgradeStat('rate')">SPEED <span id="u-spd">30</span></button>
        </div>
        <button class="btn close" onclick="deselectTurret()">BACK TO SHOP</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 1000; canvas.height = 600;

        let health = 100, money = 120, wave = 0;
        let enemies = [], turrets = [], projectiles = [], stars = [];
        let selectedType = null, selectedTurret = null, waveActive = false;

        // Init Stars
        for(let i=0; i<150; i++) stars.push({x: Math.random()*canvas.width, y: Math.random()*canvas.height, s: Math.random()*2});

        const DEFS = {
            BEAM: { cost: 25, range: 160, damage: 4, rate: 25, color: '#0ff', type: 'ATTACK' },
            PULSE: { cost: 60, range: 220, damage: 15, rate: 55, color: '#f0f', type: 'ATTACK' },
            MINER: { cost: 40, range: 0, damage: 0, rate: 120, color: '#ff0', type: 'ECON' },
            GRAVITY: { cost: 75, range: 150, damage: 0, rate: 1, color: '#55f', type: 'SLOW' },
            RAILGUN: { cost: 120, range: 550, damage: 80, rate: 150, color: '#fff', type: 'ATTACK' }
        };

        const planet = { x: canvas.width/2, y: canvas.height/2, r: 60 };

        function setTurret(type) {
            selectedType = type; deselectTurret();
            document.querySelectorAll('#shop .btn').forEach(b => b.classList.remove('active'));
            if(type) document.getElementById('btn-'+type).classList.add('active');
        }

        function deselectTurret() {
            selectedTurret = null;
            document.getElementById('upgrade-menu').style.display = 'none';
            document.getElementById('shop').style.display = 'flex';
        }

        canvas.addEventListener('mousedown', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX - rect.left) * (canvas.width / rect.width);
            const y = (e.clientY - rect.top) * (canvas.height / rect.height);

            const t = turrets.find(t => Math.hypot(t.x - x, t.y - y) < 20);
            if (t) {
                selectedTurret = t; setTurret(null);
                document.getElementById('shop').style.display = 'none';
                document.getElementById('upgrade-menu').style.display = 'flex';
                updateUpgradeUI();
                return;
            }

            if (selectedType) {
                const dist = Math.hypot(x - planet.x, y - planet.y);
                if (dist > planet.r + 30 && dist < 450 && money >= DEFS[selectedType].cost) {
                    money -= DEFS[selectedType].cost;
                    turrets.push({ x, y, ...DEFS[selectedType], level: 1, timer: 0, name: selectedType });
                    updateUI();
                }
            }
        });

        function updateUpgradeUI() {
            const cost = 40 * selectedTurret.level;
            document.getElementById('upgrade-title').innerText = `${selectedTurret.name} (LEVEL ${selectedTurret.level})`;
            document.getElementById('u-dmg').innerText = `${cost} SCRAP`;
            document.getElementById('u-rng').innerText = `${cost} SCRAP`;
            document.getElementById('u-spd').innerText = `${cost} SCRAP`;
        }

        function upgradeStat(stat) {
            const cost = 40 * selectedTurret.level;
            if (money >= cost) {
                money -= cost;
                selectedTurret.level++;
                if (stat === 'damage') selectedTurret.damage *= 1.6;
                if (stat === 'range') selectedTurret.range += 50;
                if (stat === 'rate') selectedTurret.rate = Math.max(4, selectedTurret.rate * 0.75);
                updateUpgradeUI(); updateUI();
            }
        }

        function repairPlanet() { if (money >= 50 && health < 100) { money -= 50; health = Math.min(100, health + 25); updateUI(); } }

        function updateUI() {
            document.getElementById('health').innerText = Math.round(health);
            document.getElementById('money').innerText = Math.floor(money);
            document.getElementById('wave').innerText = wave;
        }

        function spawnWave() {
            wave++; waveActive = true;
            let count = 6 + (wave * 2);
            let isBoss = wave % 5 === 0;
            for (let i = 0; i < (isBoss ? count + 1 : count); i++) {
                setTimeout(() => {
                    const angle = Math.random() * Math.PI * 2;
                    const boss = isBoss && i === 0;
                    enemies.push({
                        x: planet.x + Math.cos(angle)*800, y: planet.y + Math.sin(angle)*800,
                        hp: (5 + wave * 4) * (boss ? 10 : 1), maxHp: (5 + wave * 4) * (boss ? 10 : 1),
                        speed: boss ? 0.3 : 0.8 + (wave * 0.04), size: boss ? 45 : 14, boss
                    });
                    if(i === count - 1) waveActive = false;
                }, i * 500);
            }
        }

        function gameLoop() {
            ctx.fillStyle = '#000'; ctx.fillRect(0,0,canvas.width,canvas.height);
            
            // Stars
            ctx.fillStyle = '#fff';
            stars.forEach(s => ctx.fillRect(s.x, s.y, s.s, s.s));

            // Planet
            ctx.shadowBlur = 20; ctx.shadowColor = health > 30 ? '#0ff' : '#f00';
            ctx.beginPath(); ctx.arc(planet.x, planet.y, planet.r, 0, Math.PI*2);
            ctx.fillStyle = '#102545'; ctx.fill();
            ctx.strokeStyle = health > 30 ? '#0ff' : '#f44'; ctx.lineWidth = 4; ctx.stroke();
            ctx.shadowBlur = 0;

            // Enemies
            enemies.forEach((en, i) => {
                let speedMod = 1;
                turrets.filter(t => t.type === 'SLOW').forEach(t => { if(Math.hypot(en.x-t.x, en.y-t.y) < t.range) speedMod = 0.4; });
                const dx = planet.x-en.x, dy = planet.y-en.y, dist = Math.hypot(dx, dy);
                en.x += (dx/dist)*en.speed*speedMod; en.y += (dy/dist)*en.speed*speedMod;
                
                ctx.fillStyle = en.boss ? '#f0f' : '#f44';
                ctx.fillRect(en.x-en.size/2, en.y-en.size/2, en.size, en.size);
                
                // HP bars for bosses
                if(en.boss) {
                    ctx.fillStyle = '#222'; ctx.fillRect(en.x-20, en.y-35, 40, 5);
                    ctx.fillStyle = '#0f0'; ctx.fillRect(en.x-20, en.y-35, (en.hp/en.maxHp)*40, 5);
                }

                if (dist < planet.r) { health -= en.boss ? 40 : 8; enemies.splice(i,1); updateUI(); }
            });

            // Turrets
            turrets.forEach(t => {
                ctx.fillStyle = t.color;
                ctx.beginPath(); ctx.arc(t.x, t.y, 8, 0, Math.PI*2); ctx.fill();
                if(selectedTurret === t) {
                    ctx.strokeStyle = 'rgba(0,255,255,0.4)'; ctx.beginPath(); ctx.arc(t.x, t.y, t.range, 0, Math.PI*2); ctx.stroke();
                }
                t.timer++;
                if (t.timer >= t.rate) {
                    if(t.type === 'ECON') { money += (5 + (t.level*2)); updateUI(); }
                    else if (t.type === 'ATTACK') {
                        const target = enemies.find(en => Math.hypot(en.x-t.x, en.y-t.y) < t.range);
                        if (target) projectiles.push({ x: t.x, y: t.y, tx: target.x, ty: target.y, color: t.color, damage: t.damage });
                    }
                    t.timer = 0;
                }
            });

            // Projectiles
            projectiles.forEach((p, i) => {
                const dx = p.tx-p.x, dy = p.ty-p.y, dist = Math.hypot(dx, dy);
                if (dist < 20) {
                    const en = enemies.find(e => Math.hypot(e.x-p.tx, e.y-p.ty) < 50);
                    if (en) { en.hp -= p.damage; if (en.hp <= 0) { money += en.boss ? 100 : 12; enemies.splice(enemies.indexOf(en), 1); updateUI(); } }
                    projectiles.splice(i, 1);
                } else {
                    p.x += (dx/dist)*25; p.y += (dy/dist)*25;
                    ctx.strokeStyle = p.color; ctx.lineWidth = 4;
                    ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x-(dx/dist)*20, p.y-(dy/dist)*20); ctx.stroke();
                }
            });

            if (enemies.length === 0 && !waveActive && health > 0) spawnWave();
            if (health > 0) requestAnimationFrame(gameLoop);
            else {
                ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fillRect(0,0,canvas.width,canvas.height);
                ctx.fillStyle='#f00'; ctx.textAlign='center'; ctx.font='bold 50px Arial'; ctx.fillText('ORBITAL DEFENSE FAILED', canvas.width/2, canvas.height/2);
                ctx.font='20px Arial'; ctx.fillText('Final Wave: ' + wave, canvas.width/2, canvas.height/2 + 60);
            }
        }

        window.addEventListener('keydown', (e) => {
            if(e.key === 'Escape') deselectTurret();
            if(e.key === '1') setTurret('BEAM');
            if(e.key === '2') setTurret('PULSE');
            if(e.key === '3') setTurret('MINER');
            if(e.key === '4') setTurret('GRAVITY');
            if(e.key === '5') setTurret('RAILGUN');
        });

        updateUI(); spawnWave(); gameLoop();
    </script>
</body>
</html>
